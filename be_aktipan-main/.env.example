# AKTIPAN Backend Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya

# === DEVELOPMENT ===
PORT=5000
NODE_ENV=development
JWT_SECRET=aktipan_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ADMIN_DEFAULT_EMAIL=admin@aktipan.com
ADMIN_DEFAULT_PASSWORD=admin123

# === PRODUCTION (Vercel Environment Variables) ===
# Tambahkan variable berikut di Vercel Dashboard > Settings > Environment Variables:
# NODE_ENV=production
# JWT_SECRET=GANTI_DENGAN_SECRET_KUAT_MINIMAL_32_CHAR
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
# ADMIN_DEFAULT_EMAIL=admin@aktipan.com
# ADMIN_DEFAULT_PASSWORD=GANTI_PASSWORD_ADMIN_PRODUKSI
