# MongoDB Atlas Connection String
# Dapatkan dari: https://www.mongodb.com/atlas/database
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/aktipan?retryWrites=true&w=majority

# JWT Secret (ganti dengan string acak yang panjang dan unik)
JWT_SECRET=aktipan_super_secret_jwt_key_2026_production_grade

# JWT Expiry
JWT_EXPIRES_IN=7d

# Port (Railway akan mengisi ini otomatis, tidak perlu diisi manual)
PORT=5000

# CORS Origin (URL frontend Vercel Anda, pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=https://aktipan-frontend.vercel.app
