# AKTIPAN Frontend Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya

# === DEVELOPMENT ===
# Gunakan path relatif agar Vite proxy meneruskan ke backend lokal di port 5000
VITE_API_URL=/api
VITE_WS_ARENA_URL=ws://localhost:5000/ws/arena

# === PRODUCTION (Vercel) ===
# Isi dengan URL backend yang sudah di-deploy:
# VITE_API_URL=https://YOUR-BACKEND.vercel.app/api
# VITE_WS_ARENA_URL=wss://YOUR-BACKEND.railway.app/ws/arena
